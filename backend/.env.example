# Google OAuth2 — create at https://console.cloud.google.com
# Enable Gmail API, add OAuth2 credentials (Web Application type)
# Authorised redirect URI: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL (for OAuth2 redirect after login)
FRONTEND_URL=http://localhost:5173

# Server port
PORT=3001
